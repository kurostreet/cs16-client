+// Publish only server-assigned IDs and public avatar tags. No nicknames or credentials.
+static void CL_CzmTabState( void )
+{
+ char state[2048] = "";
+ if( cls.state == ca_active && !cls.demoplayback && cl.maxclients > 1
+  && cl.playernum >= 0 && cl.playernum < cl.maxclients && cl.players[cl.playernum].userid > 0 )
+ {
+  Q_snprintf( state, sizeof( state ), "%s %d\n", NET_AdrToString( cls.netchan.remote_address ), cl.players[cl.playernum].userid );
+  for( int i = 0; i < Q_min( cl.maxclients, 32 ); i++ )
+  {
+   const player_info_t *p = &cl.players[i];
+   if( !p->name[0] || p->userid <= 0 ) continue;
+   const char *tag = Info_ValueForKey( p->userinfo, "czm_tag" );
+   qboolean valid = Q_strlen( tag ) == 32;
+   for( int n = 0; valid && n < 32; n++ )
+    if( !( tag[n] >= '0' && tag[n] <= '9' ) && !( tag[n] >= 'a' && tag[n] <= 'f' )) valid = false;
+   size_t used = Q_strlen( state );
+   Q_snprintf( state + used, sizeof( state ) - used, "%d %d %s\n", i + 1, p->userid, valid ? tag : "-" );
+  }
+ }
+ if( Q_strcmp( czm_tab_state.string, state )) Cvar_DirectFullSet( &czm_tab_state, state, FCVAR_READ_ONLY|FCVAR_PRIVILEGED );
+}
