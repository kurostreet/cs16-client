+
+// The engine only tracks loading progress here and publishes it through cvars.
+// The menu library draws the screen (art, text, progress bar, cancel button).
+
+#include "common.h"
+#include "client.h"
+#include "input.h"
+#include "net_api.h"
+#include "voice.h"
+
+#define CZM_INFO_CONTEXT 0x435a4d01 // 'CZM' + 1, NetAPI context for the server details query
+#define CZM_QUERY_CONTEXT 0x435a4d10 // NetAPI contexts for the menu server tiles
+
+enum
+{
+	CZM_STAGE_NONE = 0,
+	CZM_STAGE_CONNECT,   // waiting for the server to accept us
+	CZM_STAGE_HANDSHAKE, // server data and resource list
+	CZM_STAGE_DOWNLOAD,  // downloading missing server files
+	CZM_STAGE_PRECACHE,  // loading the map, models and sounds
+	CZM_STAGE_ENTER,     // spawn sent, waiting to enter the game
+	CZM_STAGE_LOCAL,     // starting a local game
+};
+
+static CVAR_DEFINE_AUTO( czm_loading_enable, "1", FCVAR_ARCHIVE, "draw the Counter Zombie Mobile loading screen instead of the console" );
+static CVAR_DEFINE_AUTO( czm_loading_pump, "1", FCVAR_ARCHIVE, "redraw the loading screen while the map and models are loaded" );
+static CVAR_DEFINE_AUTO( czm_loading, "0", 0, "loading screen is active (read by the menu)" );
+static CVAR_DEFINE_AUTO( czm_loading_session, "0", 0, "increments for every loading screen (read by the menu)" );
+static CVAR_DEFINE_AUTO( czm_loading_stage, "0", 0, "current loading stage (read by the menu)" );
+static CVAR_DEFINE_AUTO( czm_loading_dl, "", 0, "download progress: files_done files_total bytes_done bytes_total bytes_per_sec" );
+static CVAR_DEFINE_AUTO( czm_loading_host, "", 0, "server name for the loading screen" );
+static CVAR_DEFINE_AUTO( czm_loading_map, "", 0, "map name for the loading screen" );
+static CVAR_DEFINE_AUTO( czm_loading_players, "", 0, "players on the server for the loading screen" );
+static CVAR_DEFINE_AUTO( czm_loading_ping, "", 0, "ping to the server in milliseconds for the loading screen" );
+static CVAR_DEFINE_AUTO( czm_loading_error, "", 0, "why the last connection failed, shown by the menu" );
+
+static struct
+{
+	qboolean active;
+	qboolean forced;        // local game is starting, client is not connecting yet
+	qboolean seen_loading;  // client went through a connecting state in this session
+	qboolean spawn_sent;
+	qboolean precache;
+	qboolean serverdata;    // server data parsed: map, max players and player slots are valid
+	int      info_requests;
+	double   info_time;
+	qboolean info_answered;
+	qboolean cancelled;
+	qboolean reopen_menu;
+	qboolean had_downloads;
+
+	double   start;
+	double   forced_time;
+	double   enter_time;
+	double   last_pump;
+	double   speed_time;
+
+	float    percent;
+	float    speed;
+	int      speed_bytes;
+
+	int      dl_files_total;
+	int      dl_bytes_total;
+	int      pc_total;
+	int      pc_done;
+
+	int      info_players;
+	int      info_max;
+	int      info_ping;
+	char     info_host[64];
+	char     info_map[64];
+	char     remote_host[64];
+	char     error[256];
+} czm;
+
+static void CZM_SetString( convar_t *var, const char *value )
+{
+	if( Q_strcmp( var->string, value ))
+		Cvar_DirectSet( var, value );
+}
+
+static void CZM_SetValue( convar_t *var, float value )
+{
+	if( var->value != value )
+		Cvar_DirectSetValue( var, value );
+}
+
+qboolean CZM_Loading_Enabled( void )
+{
+	return czm_loading_enable.value != 0.0f;
+}
+
+qboolean CZM_Loading_Active( void )
+{
+	return czm.active;
+}
+
+/*
+=================
+server info queries
+
+Some GoldSrc servers drop the NetAPI query because it carries a -1 challenge,
+so we also send the plain query. NetAPI still handles servers that answer with
+a challenge first. The first answer after a query gives the ping (many servers
+ignore the ping packet).
+=================
+*/
+#define CZM_MAX_QUERIES 16
+
+static struct
+{
+	netadr_t adr;
+	double   sent;
+} czm_queries[CZM_MAX_QUERIES];
+
+static void CZM_SendInfoQuery( netadr_t *adr, int context, net_api_response_func_t func )
+{
+	double now = Platform_DoubleTime();
+	double oldest = now;
+	int slot = 0;
+	byte buf[64];
+	sizebuf_t msg;
+
+	for( int i = 0; i < CZM_MAX_QUERIES; i++ )
+	{
+		if( NET_CompareAdr( czm_queries[i].adr, *adr ))
+		{
+			slot = i;
+			break;
+		}
+
+		if( czm_queries[i].sent < oldest )
+		{
+			oldest = czm_queries[i].sent;
+			slot = i;
+		}
+	}
+
+	czm_queries[slot].adr = *adr;
+	czm_queries[slot].sent = now;
+
+	MSG_Init( &msg, "CZMQuery", buf, sizeof( buf ));
+	MSG_WriteString( &msg, A2S_GOLDSRC_INFO );
+	Netchan_OutOfBand( NS_CLIENT, *adr, MSG_GetNumBytesWritten( &msg ), MSG_GetData( &msg ));
+
+	gNetApi.SendRequest( context, NETAPI_REQUEST_DETAILS, 0, 4.0, adr, func );
+}
+
+// the server asked for a challenge, the engine resends the query right away
+void CZM_Loading_QueryChallenge( netadr_t from )
+{
+	for( int i = 0; i < CZM_MAX_QUERIES; i++ )
+	{
+		if( czm_queries[i].sent > 0.0 && NET_CompareAdr( czm_queries[i].adr, from ))
+		{
+			czm_queries[i].sent = Platform_DoubleTime();
+			break;
+		}
+	}
+}
+
+// any server info answer, info is the infostring the menu gets (host, map, numcl, maxcl)
+void CZM_Loading_InfoReply( netadr_t from, const char *info )
+{
+	double now = Platform_DoubleTime();
+	qboolean ours = czm.active && NET_CompareAdr( from, cls.serveradr );
+
+	for( int i = 0; i < CZM_MAX_QUERIES; i++ )
+	{
+		if( czm_queries[i].sent <= 0.0 || !NET_CompareAdr( czm_queries[i].adr, from ))
+			continue;
+
+		if( now - czm_queries[i].sent < 5.0 )
+		{
+			int ping = (int)(( now - czm_queries[i].sent ) * 1000.0 );
+			char s[64];
+
+			if( ours )
+				czm.info_ping = ping;
+
+			Q_snprintf( s, sizeof( s ), "\\czmping\\%d", ping );
+			UI_AddServerToList( from, s );
+		}
+
+		czm_queries[i].sent = 0.0; // only the first answer counts
+		break;
+	}
+
+	if( ours )
+	{
+		czm.info_answered = true;
+		czm.info_players = Q_atoi( Info_ValueForKey( info, "numcl" ));
+		czm.info_max = Q_atoi( Info_ValueForKey( info, "maxcl" ));
+		Q_strncpy( czm.info_host, Info_ValueForKey( info, "host" ), sizeof( czm.info_host ));
+		Q_strncpy( czm.info_map, Info_ValueForKey( info, "map" ), sizeof( czm.info_map ));
+	}
+}
+
+static void CZM_InfoResponse( net_response_t *response )
+{
+	const char *s;
+
+	if( !czm.active || response->error != NET_SUCCESS || !response->response )
+		return;
+
+	s = (const char *)response->response;
+	czm.info_answered = true;
+
+	czm.info_players = Q_atoi( Info_ValueForKey( s, "current" ));
+	czm.info_max = Q_atoi( Info_ValueForKey( s, "max" ));
+	czm.info_ping = (int)( response->ping * 1000.0 );
+	Q_strncpy( czm.info_host, Info_ValueForKey( s, "hostname" ), sizeof( czm.info_host ));
+	Q_strncpy( czm.info_map, Info_ValueForKey( s, "map" ), sizeof( czm.info_map ));
+}
+
+static void CZM_Begin( void )
+{
+	int session = (int)czm_loading_session.value + 1;
+	qboolean forced = czm.forced;
+	double forced_time = czm.forced_time;
+
+	memset( &czm, 0, sizeof( czm ));
+	czm.active = true;
+	czm.forced = forced;
+	czm.forced_time = forced_time;
+	czm.start = Platform_DoubleTime();
+
+	CZM_SetString( &czm_loading_error, "" );
+	CZM_SetString( &czm_loading_host, "" );
+	CZM_SetString( &czm_loading_map, "" );
+	CZM_SetString( &czm_loading_players, "" );
+	CZM_SetString( &czm_loading_ping, "" );
+	CZM_SetString( &czm_loading_dl, "" );
+	CZM_SetValue( &czm_loading_stage, CZM_STAGE_CONNECT );
+	CZM_SetValue( &czm_loading_session, session );
+	CZM_SetValue( &czm_loading, 1 );
+	Cvar_SetValue( "scr_loading", 0.0f );
+
+	Touch_ResetLoadingInput();
+}
+
+static void CZM_End( qboolean reached_game )
+{
+	qboolean reopen = czm.reopen_menu;
+
+	if( !reached_game && !czm.cancelled && czm.seen_loading && cls.state == ca_disconnected )
+	{
+		// tell the player why we are back in the menu
+		if( COM_StringEmpty( czm.error ))
+			Q_strncpy( czm.error, "#connect_failed", sizeof( czm.error ));
+		CZM_SetString( &czm_loading_error, czm.error );
+	}
+
+	czm.active = false;
+	czm.forced = false;
+	CZM_SetValue( &czm_loading, 0 );
+	CZM_SetValue( &czm_loading_stage, CZM_STAGE_NONE );
+	Cvar_SetValue( "scr_loading", reached_game ? 100.0f : 0.0f );
+
+	if( reopen && cls.state == ca_disconnected && cls.key_dest != key_menu )
+		UI_SetActiveMenu( true );
+}
+
+static void CZM_CountMissing( int *files, int *bytes, int *current_size )
+{
+	const char *current = host.downloadfile;
+
+	*files = *bytes = *current_size = 0;
+
+	for( resource_t *p = cl.resourcesneeded.pNext; p && p != &cl.resourcesneeded; p = p->pNext )
+	{
+		if( !FBitSet( p->ucFlags, RES_WASMISSING ))
+			continue;
+
+		( *files )++;
+		*bytes += p->nDownloadSize;
+
+		if( !COM_StringEmpty( current ) && Q_stristr( current, p->szFileName ))
+			*current_size = p->nDownloadSize;
+	}
+}
+
+static int CZM_CountPlayers( void )
+{
+	int count = 0;
+
+	for( int i = 0; i < cl.maxclients && i < MAX_CLIENTS; i++ )
+	{
+		if( !COM_StringEmpty( cl.players[i].name ))
+			count++;
+	}
+
+	return count;
+}
+
+static void CZM_RequestInfo( void )
+{
+	netadr_t adr = cls.serveradr;
+	double now = Platform_DoubleTime();
+
+	// UDP may lose the query, ask up to three times while connecting
+	if( czm.info_answered || czm.info_requests >= 3 || now - czm.info_time < 2.0 )
+		return;
+
+	if( cls.state != ca_connecting && cls.state != ca_connected && cls.state != ca_validate )
+		return;
+
+	if( NET_NetadrType( &adr ) == NA_UNDEFINED || NET_IsLocalAddress( adr ))
+		return;
+
+	czm.info_requests++;
+	czm.info_time = now;
+	CZM_SendInfoQuery( &adr, CZM_INFO_CONTEXT, CZM_InfoResponse );
+}
+
+static void CZM_UpdateInfo( void )
+{
+	char buf[64];
+	int players, maxplayers;
+	const char *host;
+
+	// server name: GoldSrc servers send it with the server data, the query gives it earlier
+	if( !COM_StringEmpty( czm.remote_host ))
+		host = czm.remote_host;
+	else if( !COM_StringEmpty( czm.info_host ))
+		host = czm.info_host;
+	else if( SV_Active( ))
+		host = Cvar_VariableString( "hostname" );
+	else host = cls.servername;
+	CZM_SetString( &czm_loading_host, host ? host : "" );
+
+	// before the server data arrives, map name and slots in the client state are stale
+	if( czm.serverdata && !COM_StringEmpty( clgame.mapname ))
+		CZM_SetString( &czm_loading_map, clgame.mapname );
+	else CZM_SetString( &czm_loading_map, czm.info_map );
+
+	players = czm.serverdata ? CZM_CountPlayers() : 0;
+	if( players <= 0 )
+		players = czm.info_players;
+	maxplayers = czm.serverdata && cl.maxclients > 1 ? cl.maxclients : czm.info_max;
+
+	if( maxplayers > 0 )
+		Q_snprintf( buf, sizeof( buf ), "%d/%d", Q_max( players, 0 ), maxplayers );
+	else buf[0] = 0;
+	CZM_SetString( &czm_loading_players, buf );
+
+	if( czm.info_ping > 0 )
+		Q_snprintf( buf, sizeof( buf ), "%d", czm.info_ping );
+	else buf[0] = 0;
+	CZM_SetString( &czm_loading_ping, buf );
+}
+
+static void CZM_Update( void )
+{
+	double now = Platform_DoubleTime();
+	int stage, files, bytes, current_size, done_files = 0, done_bytes = 0;
+	float target = 0.0f;
+	char buf[128];
+
+	CZM_RequestInfo();
+	CZM_UpdateInfo();
+
+	CZM_CountMissing( &files, &bytes, &current_size );
+
+	if( cls.state == ca_disconnected || ( czm.forced && !czm.seen_loading ))
+		stage = czm.forced ? CZM_STAGE_LOCAL : CZM_STAGE_CONNECT;
+	else if( cls.state == ca_connecting )
+		stage = CZM_STAGE_CONNECT;
+	else if( czm.spawn_sent )
+		stage = CZM_STAGE_ENTER;
+	else if( czm.precache )
+		stage = CZM_STAGE_PRECACHE;
+	else if( cls.state == ca_validate && files > 0 )
+		stage = CZM_STAGE_DOWNLOAD;
+	else stage = CZM_STAGE_HANDSHAKE;
+
+	if( files > 0 )
+	{
+		czm.had_downloads = true;
+		czm.dl_files_total = Q_max( czm.dl_files_total, files );
+		czm.dl_bytes_total = Q_max( czm.dl_bytes_total, bytes );
+	}
+
+	if( czm.had_downloads )
+	{
+		float fraction = scr_download.value > 0.0f ? bound( 0.0f, scr_download.value * 0.01f, 1.0f ) : 0.0f;
+
+		done_files = czm.dl_files_total - files;
+		done_bytes = czm.dl_bytes_total - bytes + (int)( current_size * fraction );
+		done_bytes = bound( 0, done_bytes, czm.dl_bytes_total );
+
+		// download speed, smoothed over half a second
+		if( czm.speed_time == 0.0 )
+		{
+			czm.speed_time = now;
+			czm.speed_bytes = done_bytes;
+		}
+		else if( now - czm.speed_time >= 0.5 )
+		{
+			float sample = ( done_bytes - czm.speed_bytes ) / ( now - czm.speed_time );
+			czm.speed = czm.speed > 0.0f ? czm.speed * 0.6f + sample * 0.4f : sample;
+			czm.speed_time = now;
+			czm.speed_bytes = done_bytes;
+		}
+
+		Q_snprintf( buf, sizeof( buf ), "%d %d %d %d %d", done_files, czm.dl_files_total,
+			done_bytes, czm.dl_bytes_total, (int)Q_max( czm.speed, 0.0f ));
+		CZM_SetString( &czm_loading_dl, buf );
+	}
+
+	switch( stage )
+	{
+	case CZM_STAGE_LOCAL:
+		target = Q_min( 4.0f + ( now - czm.start ) * 6.0f, 40.0f );
+		break;
+	case CZM_STAGE_CONNECT:
+		target = Q_min( 2.0f + ( now - czm.start ) * 2.0f, 8.0f );
+		break;
+	case CZM_STAGE_HANDSHAKE:
+		target = 10.0f;
+		break;
+	case CZM_STAGE_DOWNLOAD:
+		if( czm.dl_bytes_total > 0 )
+			target = 12.0f + 63.0f * done_bytes / czm.dl_bytes_total;
+		else if( czm.dl_files_total > 0 )
+			target = 12.0f + 63.0f * done_files / czm.dl_files_total;
+		break;
+	case CZM_STAGE_PRECACHE:
+	{
+		float base = czm.had_downloads ? 75.0f : 15.0f;
+		target = base + ( 94.0f - base ) * ( czm.pc_total > 0 ? (float)czm.pc_done / czm.pc_total : 0.0f );
+		break;
+	}
+	case CZM_STAGE_ENTER:
+		target = Q_min( 95.0f + ( now - czm.enter_time ) * 3.0f, 99.0f );
+		break;
+	}
+
+	czm.percent = Q_max( czm.percent, target );
+	CZM_SetValue( &czm_loading_stage, stage );
+	Cvar_SetValue( "scr_loading", (int)czm.percent );
+}
+
+/*
+=================
+microphone test for the settings screen
+
+Opens the microphone in the menu (outside a match the voice chat does not use it)
+and shows the input level, so a player can see that the microphone works.
+czm_miclevel: 0..100 while the test runs, -1 no microphone or no permission,
+-2 not available in a match.
+=================
+*/
+static CVAR_DEFINE_AUTO( czm_miclevel, "0", 0, "microphone level of the settings test (read by the menu)" );
+
+static struct
+{
+	qboolean active;
+	double start, last;
+	float level;
+	uint width, samplerate, frame_size; // voice settings before the test
+} czm_mic;
+
+static void CZM_MicStop( void )
+{
+	if( !czm_mic.active )
+		return;
+
+	czm_mic.active = false;
+	VoiceCapture_Activate( false );
+	VoiceCapture_Shutdown();
+	voice.input_buffer_pos = 0;
+	voice.width = czm_mic.width;
+	voice.samplerate = czm_mic.samplerate;
+	voice.frame_size = czm_mic.frame_size;
+	CZM_SetValue( &czm_miclevel, 0.0f );
+}
+
+static void CZM_MicTest_f( void )
+{
+	qboolean on = Cmd_Argc() > 1 && Q_atoi( Cmd_Argv( 1 )) != 0;
+
+	if( !on )
+	{
+		CZM_MicStop();
+		return;
+	}
+
+	if( czm_mic.active )
+	{
+		czm_mic.start = Platform_DoubleTime(); // the menu asks again, keep it running
+		return;
+	}
+
+	// in a match the voice chat owns the microphone
+	if( cls.state != ca_disconnected || voice.device_opened )
+	{
+		CZM_SetValue( &czm_miclevel, -2.0f );
+		return;
+	}
+
+	czm_mic.width = voice.width;
+	czm_mic.samplerate = voice.samplerate;
+	czm_mic.frame_size = voice.frame_size;
+	voice.width = sizeof( int16_t );
+	voice.samplerate = GS_DEFAULT_SAMPLE_RATE;
+	voice.frame_size = GS_DEFAULT_FRAME_SIZE;
+	voice.input_buffer_pos = 0;
+
+	if( !VoiceCapture_Init( ))
+	{
+		voice.width = czm_mic.width;
+		voice.samplerate = czm_mic.samplerate;
+		voice.frame_size = czm_mic.frame_size;
+		CZM_SetValue( &czm_miclevel, -1.0f );
+		return;
+	}
+
+	VoiceCapture_Activate( true );
+	czm_mic.active = true;
+	czm_mic.start = czm_mic.last = Platform_DoubleTime();
+	czm_mic.level = 0.0f;
+	CZM_SetValue( &czm_miclevel, 0.0f );
+}
+
+static void CZM_MicTest_Frame( void )
+{
+	double now = Platform_DoubleTime();
+	const int16_t *samples;
+	int count, peak = 0;
+	float level;
+
+	if( !czm_mic.active )
+		return;
+
+	// a match starts, or the menu forgot about the test
+	if( cls.state != ca_disconnected || now - czm_mic.start > 60.0 )
+	{
+		CZM_MicStop();
+		return;
+	}
+
+	VoiceCapture_Lock( true );
+	samples = (const int16_t *)voice.input_buffer;
+	count = voice.input_buffer_pos / sizeof( int16_t );
+	for( int i = 0; i < count; i++ )
+	{
+		int v = abs( samples[i] );
+		if( v > peak )
+			peak = v;
+	}
+	voice.input_buffer_pos = 0;
+	VoiceCapture_Lock( false );
+
+	// square root makes normal speech fill the middle of the meter, the level falls slowly
+	level = sqrtf( peak / 32767.0f ) * 100.0f;
+	czm_mic.level = Q_max( level, czm_mic.level - (float)( now - czm_mic.last ) * 120.0f );
+	czm_mic.level = bound( 0.0f, czm_mic.level, 100.0f );
+	czm_mic.last = now;
+	CZM_SetValue( &czm_miclevel, (int)czm_mic.level );
+}
+
+void CZM_Loading_Frame( void )
+{
+	qboolean loading_state = cls.state == ca_connecting || cls.state == ca_connected || cls.state == ca_validate;
+	qboolean want;
+
+	CZM_MicTest_Frame();
+
+	if( czm.forced && !czm.active && cls.state == ca_active )
+		loading_state = false; // changelevel on a local server, wait for the reconnect
+
+	// a local game that never started connecting
+	if( czm.forced && cls.state == ca_disconnected && Platform_DoubleTime() - czm.forced_time > 60.0 )
+		czm.forced = false;
+
+	want = CZM_Loading_Enabled() && !cls.demoplayback && !cls.changedemo && !cl.background && ( czm.forced || loading_state );
+
+	if( czm.active && loading_state )
+		czm.seen_loading = true;
+
+	// finished: the client is in the game
+	if( czm.active && cls.state == ca_active && czm.seen_loading )
+	{
+		CZM_End( true );
+		return;
+	}
+
+	if( want && !czm.active )
+		CZM_Begin();
+	else if( !want && czm.active )
+		CZM_End( cls.state == ca_active );
+
+	if( czm.active )
+		CZM_Update();
+}
+
+void CZM_Loading_BeginLocal( void )
+{
+	if( !CZM_Loading_Enabled( ))
+		return;
+
+	czm.forced = true;
+	czm.forced_time = Platform_DoubleTime();
+	CZM_Loading_Frame();
+}
+
+void CZM_Loading_ServerData( void )
+{
+	czm.serverdata = true;
+}
+
+void CZM_Loading_SetHostname( const char *hostname )
+{
+	if( hostname )
+		Q_strncpy( czm.remote_host, hostname, sizeof( czm.remote_host ));
+}
+
+void CZM_Loading_SetError( const char *reason )
+{
+	if( !czm.active || COM_StringEmpty( reason ))
+		return;
+
+	Q_strncpy( czm.error, reason, sizeof( czm.error ));
+}
+
+void CZM_Loading_PrecacheBegin( void )
+{
+	int total = 0;
+
+	if( !czm.active )
+		return;
+
+	for( resource_t *p = cl.resourcesonhand.pNext; p && p != &cl.resourcesonhand; p = p->pNext )
+	{
+		if( !FBitSet( p->ucFlags, RES_PRECACHED ))
+			total++;
+	}
+
+	czm.precache = true;
+	czm.pc_total = total;
+	czm.pc_done = 0;
+	czm.last_pump = 0.0;
+	CZM_Loading_Pump();
+}
+
+void CZM_Loading_PrecacheStep( void )
+{
+	if( !czm.active || !czm.precache )
+		return;
+
+	czm.pc_done++;
+	CZM_Loading_Pump();
+}
+
+void CZM_Loading_SpawnSent( void )
+{
+	if( !czm.active )
+		return;
+
+	czm.spawn_sent = true;
+	czm.enter_time = Platform_DoubleTime();
+}
+
+// redraw the loading screen while the client is busy inside one frame
+void CZM_Loading_Pump( void )
+{
+	double now;
+
+	if( !czm.active || czm_loading_pump.value == 0.0f )
+		return;
+
+	now = Platform_DoubleTime();
+	if( now - czm.last_pump < 0.08 )
+		return;
+
+	czm.last_pump = now;
+	CZM_Update();
+	SCR_UpdateScreen();
+}
+
+static void CZM_Cancel( void )
+{
+	czm.cancelled = true;
+	czm.reopen_menu = true;
+	// stop HTTP downloads of server files too, they would go on in the background
+	Cbuf_AddText( "http_clear\n" );
+	Cbuf_AddText( "disconnect\n" );
+}
+
+qboolean CZM_Loading_Escape( void )
+{
+	if( !czm.active || cls.key_dest != key_game )
+		return false;
+
+	CZM_Cancel();
+	return true;
+}
+
+// the cancel button area, in screen fractions; keep in sync with the menu drawing code
+#define CZM_CANCEL_X0 0.815f
+#define CZM_CANCEL_X1 0.955f
+#define CZM_CANCEL_Y0 0.818f
+#define CZM_CANCEL_Y1 0.898f
+
+qboolean CZM_Loading_TouchEvent( int type, float x, float y )
+{
+	if( !czm.active || cls.key_dest != key_game )
+		return false;
+
+	// small margin makes the button easier to hit
+	if( type == event_up && x >= CZM_CANCEL_X0 - 0.01f && x <= CZM_CANCEL_X1 + 0.01f
+		&& y >= CZM_CANCEL_Y0 - 0.02f && y <= CZM_CANCEL_Y1 + 0.02f )
+		CZM_Cancel();
+
+	return true; // swallow all touches while loading
+}
+
+void CZM_Loading_Disconnected( void )
+{
+	if( !czm.active )
+	{
+		czm.forced = false;
+		return;
+	}
+
+	czm.reopen_menu = true; // always return to the menu, even in developer mode
+	CZM_End( false );
+}
+
+static void CZM_QueryDetailsResponse( net_response_t *response )
+{
+	// nothing to do: the engine already passed the server info to the menu
+}
+
+// czm_queryserver <address>: ask a server for its info, the answer and the ping go to the menu
+static void CZM_QueryServer_f( void )
+{
+	netadr_t adr;
+
+	if( Cmd_Argc() != 2 )
+	{
+		Con_Printf( S_USAGE "czm_queryserver <address>\n" );
+		return;
+	}
+
+	NET_Config( true, false );
+
+	if( !NET_StringToAdr( Cmd_Argv( 1 ), &adr ))
+		return;
+
+	if( adr.port == 0 )
+		adr.port = MSG_BigShort( PORT_SERVER );
+
+	CZM_SendInfoQuery( &adr, CZM_QUERY_CONTEXT, CZM_QueryDetailsResponse );
+}
+
+void CZM_Loading_Init( void )
+{
+	Cmd_AddRestrictedCommand( "czm_queryserver", CZM_QueryServer_f, "query a server for the menu tiles" );
+	Cmd_AddRestrictedCommand( "czm_mictest", CZM_MicTest_f, "microphone test for the settings screen: czm_mictest 1|0" );
+	Cvar_RegisterVariable( &czm_miclevel );
+
+	Cvar_RegisterVariable( &czm_loading_enable );
+	Cvar_RegisterVariable( &czm_loading_pump );
+	Cvar_RegisterVariable( &czm_loading );
+	Cvar_RegisterVariable( &czm_loading_session );
+	Cvar_RegisterVariable( &czm_loading_stage );
+	Cvar_RegisterVariable( &czm_loading_dl );
+	Cvar_RegisterVariable( &czm_loading_host );
+	Cvar_RegisterVariable( &czm_loading_map );
+	Cvar_RegisterVariable( &czm_loading_players );
+	Cvar_RegisterVariable( &czm_loading_ping );
+	Cvar_RegisterVariable( &czm_loading_error );
+}
