+// Publish only public map state. Network/authentication stays in the menu.
+static void CZM_MapPictureState( void )
+{
+ static qboolean active;
+ static double alive_since;
+ if( !scr_init ) return;
+ qboolean playing = cls.state == ca_active && !cl.background && clgame.mapname[0];
+ if( !playing )
+ {
+  if( active )
+  {
+   Cvar_DirectSet( &czm_current_map, "" );
+   Cvar_DirectSetValue( &czm_mapshot_state, 0 );
+  }
+  active = false;
+  alive_since = 0;
+  if( czm_mapshot_ready.value ) Cvar_DirectSetValue( &czm_mapshot_ready, 0 );
+  return;
+ }
+ char map[64];
+ Q_strncpy( map, clgame.mapname, sizeof( map ));
+ for( char *p = map; *p; p++ ) if( *p >= 'A' && *p <= 'Z' ) *p += 'a' - 'A';
+ if( !active || Q_strcmp( map, czm_current_map.string ))
+ {
+  Cvar_DirectSet( &czm_current_map, map );
+  Cvar_DirectSetValue( &czm_map_visit, czm_map_visit.value + 1 );
+  Cvar_DirectSetValue( &czm_mapshot_state, 0 );
+  alive_since = 0;
+ }
+ active = true;
+ if( cl.local.health <= 0 || cls.spectator ) alive_since = 0;
+ else if( alive_since == 0 ) alive_since = host.realtime;
+ int ready = alive_since != 0 && host.realtime - alive_since >= 8.0;
+ if( czm_mapshot_ready.value != ready ) Cvar_DirectSetValue( &czm_mapshot_ready, ready );
+}
+
+void SCR_CzmMapPictureCapture( void )
+{
+ if( !scr_init || czm_mapshot_state.value != 1 || !czm_mapshot_ready.value
+  || cls.state != ca_active || cl.background || !cl.video_prepped || UI_IsVisible()
+  || host.status != HOST_FRAME || cls.scrshot_action != scrshot_inactive ) return;
+ // Called after the world and before HUD/touch/menu: the displayed frame keeps its HUD.
+ char path[128];
+ Q_snprintf( path, sizeof( path ), "czm_cache/maps/%s_capture.png", czm_current_map.string );
+ qboolean ok = ref.dllFuncs.VID_ScreenShot( path, VID_LEVELSHOT );
+ Cvar_DirectSetValue( &czm_mapshot_state, ok ? 2 : 3 );
+}
+
 void SCR_UpdateScreen( void )
 {
 	qboolean screen_redraw = true; // assume screen has been redrawn
 
 	CZM_Loading_Frame();
+	CZM_MapPictureState();
 
 	if( !V_PreRender( )) return;
 
