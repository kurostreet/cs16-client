+static qboolean CZM_AndroidFlag( const char *name )
+{
+#ifdef __ANDROID__
+ JNIEnv *env=Android_GetNativeObject("JNIEnv");qboolean value=false;
+ if(!env)return false;
+ if((*env)->PushLocalFrame(env,4)<0){if((*env)->ExceptionCheck(env))(*env)->ExceptionClear(env);return false;}
+ jclass c=(*env)->FindClass(env,"ru/kurostreet/counterzombiemobile/CzmNet");
+ if(c&&!(*env)->ExceptionCheck(env)){jmethodID m=(*env)->GetStaticMethodID(env,c,name,"()Z");if(m&&!(*env)->ExceptionCheck(env))value=(*env)->CallStaticBooleanMethod(env,c,m);}
+ if((*env)->ExceptionCheck(env))(*env)->ExceptionClear(env);
+ (*env)->PopLocalFrame(env,NULL);return value;
+#else
+ return false;
+#endif
+}
+
+static void CZM_AndroidProgress( int status )
+{
+#ifdef __ANDROID__
+ double now=Platform_DoubleTime();if(status==0&&now-czm.last_notify<0.5)return;czm.last_notify=now;
+ JNIEnv *env=Android_GetNativeObject("JNIEnv");if(!env)return;
+ if((*env)->PushLocalFrame(env,6)<0){if((*env)->ExceptionCheck(env))(*env)->ExceptionClear(env);return;}
+ jclass c=(*env)->FindClass(env,"ru/kurostreet/counterzombiemobile/CzmNet");
+ if(c&&!(*env)->ExceptionCheck(env)){
+  jmethodID m=(*env)->GetStaticMethodID(env,c,"loadingProgress","(III[B)V");
+  if(m&&!(*env)->ExceptionCheck(env)){
+   char label[160];Q_snprintf(label,sizeof(label),"%s / %s",czm_loading_host.string,czm_loading_map.string);
+   jbyteArray bytes=(*env)->NewByteArray(env,Q_strlen(label));
+   if(bytes){(*env)->SetByteArrayRegion(env,bytes,0,Q_strlen(label),(const jbyte *)label);(*env)->CallStaticVoidMethod(env,c,m,(jint)czm_loading_session.value,(jint)status,(jint)(status==1||status==3?100:czm.percent),bytes);}
+  }
+ }
+ if((*env)->ExceptionCheck(env))(*env)->ExceptionClear(env);(*env)->PopLocalFrame(env,NULL);
+#endif
+}
+
+qboolean CZM_Loading_WaitForForeground( void )
+{
+#ifdef __ANDROID__
+ return host.status==HOST_SLEEP || CZM_AndroidFlag("loadingWait");
+#else
+ return false;
+#endif
+}
