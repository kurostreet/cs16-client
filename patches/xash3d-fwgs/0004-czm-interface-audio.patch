diff --git a/engine/client/dll_int/cl_gameui.c b/engine/client/dll_int/cl_gameui.c
--- a/engine/client/dll_int/cl_gameui.c
+++ b/engine/client/dll_int/cl_gameui.c
@@ -692,7 +692,16 @@
 	if( COM_StringEmptyOrNULL( szSound ))
 		return;
 
-	S_StartLocalSound( szSound, VOL_NORM, false );
+	float volume = VOL_NORM;
+	if( !Q_strcmp( szSound, "czm/tapscroll.mp3" ))
+	{
+		static double last_tap = -1.0;
+		volume = bound( 0.0f, Cvar_VariableValue( "czm_ui_volume" ), 1.0f );
+		if( volume <= 0.0f || ( host.realtime >= last_tap && host.realtime - last_tap < 0.045 ))
+			return;
+		last_tap = host.realtime;
+	}
+	S_StartLocalSound( szSound, volume, false );
 }
 
