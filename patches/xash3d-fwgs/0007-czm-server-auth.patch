+// Build credentials only into the packet for its actual destination. Never mutate
+// cls.userinfo: config writes, local player info and later connections stay clean.
+static const char *CZM_ConnectUserinfo( netadr_t adr, char *out, size_t size )
+{
+ Q_strncpy( out, cls.userinfo, size );
+#ifdef __ANDROID__
+ JNIEnv *env = Android_GetNativeObject( "JNIEnv" );
+ if( !env ) return out;
+ if( (*env)->PushLocalFrame( env, 8 ) < 0 )
+ {
+  if( (*env)->ExceptionCheck( env )) (*env)->ExceptionClear( env );
+  return out;
+ }
+ jclass netclass = (*env)->FindClass( env, "ru/kurostreet/counterzombiemobile/CzmNet" );
+ if( netclass && !(*env)->ExceptionCheck( env ))
+ {
+  jmethodID method = (*env)->GetStaticMethodID( env, netclass, "serverUserinfo", "(Ljava/lang/String;[BI)[B" );
+  if( method && !(*env)->ExceptionCheck( env ))
+  {
+   jbyteArray base = (*env)->NewByteArray( env, Q_strlen( out ));
+   if( base )
+   {
+    (*env)->SetByteArrayRegion( env, base, 0, Q_strlen( out ), (const jbyte *)out );
+    jstring address = (*env)->NewStringUTF( env, NET_AdrToString( adr ));
+    jbyteArray wire = (*env)->CallStaticObjectMethod( env, netclass, method, address, base, (jint)size );
+    if( wire && !(*env)->ExceptionCheck( env ))
+    {
+     jsize length = (*env)->GetArrayLength( env, wire );
+     if( length >= 0 && length < size )
+     {
+      (*env)->GetByteArrayRegion( env, wire, 0, length, (jbyte *)out );
+      out[length] = 0;
+     }
+    }
+   }
+  }
+ }
+ if( (*env)->ExceptionCheck( env )) (*env)->ExceptionClear( env );
+ (*env)->PopLocalFrame( env, NULL );
+#endif
+ return out;
+}
